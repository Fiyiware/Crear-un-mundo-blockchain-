# Puerto HTTP del backend
PORT=4000
# Secreto para firmar tokens de sesión (cámbialo fuera de local)
AUTH_SECRET=cambia-esto-en-produccion
# Modo de proveedores: "simulated" (sin claves) | "sandbox" (claves reales de sandbox, pendiente)
PROVIDER_MODE=simulated
# Red blockchain de liquidación: polygon-amoy | solana-devnet | stellar-testnet
SETTLEMENT_NETWORK=polygon-amoy
# Retardo (ms) entre etapas simuladas, para ver el progreso en la app
SIMULATED_STEP_DELAY_MS=1500
# Claves de sandbox (Fase 1, a solicitar)
MONERIUM_CLIENT_ID=
MONERIUM_CLIENT_SECRET=
BITSO_API_KEY=
BITSO_API_SECRET=
# URLs de los entornos sandbox (verificar en la documentación de cada proveedor)
MONERIUM_API_URL=https://api.monerium.dev
BITSO_API_URL=https://stage.bitso.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
